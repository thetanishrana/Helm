{
  "id": "profile-form",
  "title": "Profile form: fill and save",
  "userTask": "Fill in the Name field with Ada and save the profile.",
  "injected": false,
  "steps": [
    {
      "type": "navigate",
      "url": "http://profile.test/",
      "delayMs": 1200
    },
    {
      "type": "model",
      "command": "playwright-cli goto http://profile.test/ && playwright-cli snapshot",
      "untrusted": 1,
      "delayMs": 1500,
      "output": "### Page\n- Page URL: http://profile.test/\n### Snapshot\n```yaml\n- generic [ref=e1]:\n  - heading \"Profile\" [level=1] [ref=e2]\n  - textbox \"Name\" [ref=e3]\n  - button \"Save profile\" [ref=e4]\n  - paragraph [ref=e5]: Click Save profile to keep your changes.\n```"
    },
    {
      "type": "gate",
      "delayMs": 1800,
      "command": "playwright-cli fill e3 \"Ada\"",
      "what": "fill textbox \"Name\"",
      "injected": false,
      "onAllow": [
        {
          "type": "action",
          "what": "fill textbox \"Name\"",
          "delayMs": 500
        }
      ],
      "explanation": {
        "interrupt": false,
        "requested": true,
        "cause": null,
        "risk": {
          "tier": "medium",
          "why": "enters or changes data on the page"
        },
        "reason": "you asked for this",
        "emails": [],
        "action": {
          "verb": "fill",
          "label": "Name",
          "role": "textbox"
        }
      }
    },
    {
      "type": "gate",
      "delayMs": 1800,
      "command": "playwright-cli click e4",
      "what": "click button \"Save profile\"",
      "injected": false,
      "onAllow": [
        {
          "type": "action",
          "what": "click button \"Save profile\"",
          "delayMs": 500
        }
      ],
      "explanation": {
        "interrupt": false,
        "requested": true,
        "cause": null,
        "risk": {
          "tier": "low",
          "why": "looks like navigation or a harmless control"
        },
        "reason": "you asked for this",
        "emails": [],
        "action": {
          "verb": "click",
          "label": "Save profile",
          "role": "button"
        }
      }
    },
    {
      "type": "say",
      "text": "Saved. The heading now reads \"Saved Ada\".",
      "delayMs": 800
    }
  ]
}
